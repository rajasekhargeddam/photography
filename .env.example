# Local shared database and full management image credentials.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=photography
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Public country code + number, digits only. Blank hides WhatsApp button.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Required for lite builds/uploads: company HTTPS origin without a trailing slash.
# Set this in Cloudflare Build variables for GitHub-connected builds.
LITE_SITE_URL=
# Run commands set local APP_ORIGIN/NEXT_PUBLIC_SITE_URL automatically.
# Runtime production origins and secrets stay in Cloudflare's secret store.
# Optional remote-publishing alternative (not needed for content:publish).
CONTENT_PUBLISH_ORIGIN=
CONTENT_PUBLISH_SECRET=
# Advanced isolated Telegram worker only. Never enable on the shared database
# while the hosted sender is active. Local web commands always disable sending.
TELEGRAM_DISPATCH_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_SINCE=
TELEGRAM_RETRY_SECRET=
