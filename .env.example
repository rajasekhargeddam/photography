# Local development. Use the deployed HTTPS origin for production builds/runtime.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
# Public country code + WhatsApp number, digits only. Blank hides the button.
NEXT_PUBLIC_WHATSAPP_NUMBER=
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=photography
# Original only: server-side credentials for managing images.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Server-only Telegram settings. Preserve the existing activation timestamp.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_SINCE=
TELEGRAM_RETRY_SECRET=
# Keep false while lite owns delivery.
TELEGRAM_LOCAL_DISPATCH_ENABLED=false
# Publishing secret must match the deployed app and contain at least 32 characters.
CONTENT_PUBLISH_SECRET=
# Operator script destination, not needed by the Worker itself.
CONTENT_PUBLISH_ORIGIN=
