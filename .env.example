NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set the canonical origin in production for same-origin request validation.
APP_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=photography
# Server-only. Replace placeholders; never use NEXT_PUBLIC_ for this value.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Server-only Telegram credentials. Never prefix these with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ISO UTC activation time; older requests are not sent to Telegram.
TELEGRAM_ALERTS_SINCE=
TELEGRAM_RETRY_SECRET=
