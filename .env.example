# Local shared database and full management image credentials.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=photography
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Public country code + number, digits only. Blank hides WhatsApp button.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Required for lite builds/uploads: company HTTPS origin without a trailing slash.
# Set this in Cloudflare Build variables for GitHub-connected builds.
LITE_SITE_URL=
# Run commands set local APP_ORIGIN/NEXT_PUBLIC_SITE_URL automatically.
# Netlify production: set both to the final public HTTPS origin (no trailing slash).
# APP_ORIGIN=https://mydreamphotography.in
# NEXT_PUBLIC_SITE_URL=https://mydreamphotography.in
# Explicit additional trusted origins, separated by commas; no wildcards.
# APP_ALLOWED_ORIGINS=https://mydreamphotography.netlify.app,https://www.mydreamphotography.in
# Runtime production origins and secrets stay in Cloudflare's secret store.
# Optional remote-publishing alternative (not needed for content:publish).
CONTENT_PUBLISH_ORIGIN=
CONTENT_PUBLISH_SECRET=
# Configured Telegram credentials enable sending, including local commands.
# Use an isolated database and test bot for manual testing.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_SINCE=
TELEGRAM_RETRY_SECRET=
