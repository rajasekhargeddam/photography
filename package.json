{
  "name": "photography",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:management",
    "dev:management": "tsx scripts/app.ts dev management",
    "dev:lite": "tsx scripts/app.ts dev lite",
    "build": "npm run build:management",
    "build:management": "tsx scripts/app.ts build management",
    "build:lite": "tsx scripts/app.ts build lite",
    "start": "npm run start:management",
    "start:management": "tsx scripts/app.ts start management",
    "start:lite": "tsx scripts/app.ts start lite",
    "preview:lite": "tsx scripts/app.ts preview lite",
    "upload:lite": "tsx scripts/app.ts upload lite",
    "check:release": "npm test && npm run lint && npm run typecheck && npm run format:check",
    "check:integration": "npm run build:management && tsx --env-file=.env.local scripts/verify-unified.ts",
    "check:bundle": "tsx scripts/app.ts bundle-check lite",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsx scripts/app.ts typecheck management",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "admin:seed": "tsx --env-file=.env.local scripts/admin-account.ts seed",
    "admin:disable": "tsx --env-file=.env.local scripts/admin-account.ts disable",
    "admin:reset-password": "tsx --env-file=.env.local scripts/admin-account.ts reset",
    "content:publish": "tsx --env-file=.env.local scripts/publish-database.ts",
    "content:publish:remote": "tsx --env-file=.env.local scripts/publish-content.ts",
    "telegram:scheduler:check": "wrangler deploy --config wrangler.telegram.jsonc --dry-run",
    "telegram:scheduler:upload": "wrangler versions upload --config wrangler.telegram.jsonc",
    "telegram:worker": "tsx --env-file=.env.local scripts/telegram-worker.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.14",
    "@reduxjs/toolkit": "2.13.0",
    "@tanstack/react-query": "5.104.1",
    "axios": "1.20.0",
    "mongodb": "^6.21.0",
    "next": "^16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-redux": "9.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.4.1",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "wrangler": "4.155.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "10.5.0"
    }
  }
}
