{
  "name": "photography",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "telegram:worker": "tsx --env-file=.env.local scripts/telegram-worker.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "admin:seed": "tsx --env-file=.env.local scripts/admin-account.ts seed",
    "admin:disable": "tsx --env-file=.env.local scripts/admin-account.ts disable",
    "admin:reset-password": "tsx --env-file=.env.local scripts/admin-account.ts reset",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:login": "wrangler login",
    "content:publish": "tsx --env-file=.env.local scripts/publish-content.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@reduxjs/toolkit": "2.13.0",
    "@tanstack/react-query": "5.104.1",
    "axios": "1.20.0",
    "mongodb": "^6.21.0",
    "next": "^16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-redux": "9.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.4.1",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "wrangler": "^4.152.0"
  }
}
